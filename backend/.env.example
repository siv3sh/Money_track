# Backend environment template — copy values into backend/.env (do not commit secrets)

MONGO_URI=
API_KEY=
CORS_ORIGINS=http://localhost:5173,https://money-track-rho-six.vercel.app

# LLM: auto | ollama | gemini
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Free-tier Gemini fallback (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Finance news (monthly report context only — not an in-app feed)
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=

# Monthly report email (Resend free tier)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Money Track <onboarding@resend.dev>
APP_BASE_URL=https://money-track-rho-six.vercel.app
