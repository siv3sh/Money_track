# Backend environment template — copy values into backend/.env (do not commit secrets)

# Supabase project (Data API). Preferred over Mongo when both are set.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional direct Postgres URI (Session pooler). Faster than the Data API.
DATABASE_URL=
# Fallback only — leave unset after migrating to Supabase.
MONGO_URI=
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tally.nuential.com,https://money-track-rho-six.vercel.app
APP_BASE_URL=https://tally.nuential.com
# Public base URL phones POST SMS to (often same as your API host)
# Production example: https://money-track-epnn.onrender.com
WEBHOOK_PUBLIC_BASE=https://money-track-epnn.onrender.com
# Resend Inbound domain for live bank-email parsing (MX on this subdomain in Resend)
# Users forward alerts to {token}@this-domain — shown on Accounts as "Copy address"
# Example after DNS + Resend verify: alerts.tally.nuential.com
RESEND_INBOUND_DOMAIN=

# First login account (created on startup if missing).
# Put real values only in local backend/.env — never commit them.
# First login account (created on startup if missing).
# Put real values only in local backend/.env — never commit them.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me-now
# Admin for /admin/users (defaults to SEED_USER_EMAIL when unset)
ADMIN_EMAIL=
# Optional: if set, Create account requires this invite code. Leave empty for open signup.
SIGNUP_CODE=
# One-shot: set true once to re-run legacy orphan→seed user_id migrate
FORCE_LEGACY_USER_MIGRATE=
# Required in production (Render). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the app falls back to API_KEY with a warning.
JWT_SECRET=
JWT_EXPIRE_DAYS=14
# Set true only for single-tenant / MacroDroid setups that still POST /sms-webhook + X-API-Key.
# Multi-tenant production should leave this unset (private /sms-webhook/{token} only).
ALLOW_LEGACY_API_KEY_WEBHOOK=

# Stripe billing (leave unset to keep all Pro features unlocked)
# Create a Product + recurring Price in Stripe Dashboard, then paste:
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
BILLING_TRIAL_DAYS=14
BILLING_PRO_PRICE_LABEL=₹299/mo

# LLM: auto | ollama | gemini
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Advisor floating chat only (import/parser/RAG keep OLLAMA_MODEL)
OLLAMA_CHAT_MODEL=llama3:8b
# Free-tier Gemini fallback (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Embeddings (Gemini text-embedding-004); falls back to local hash vectors
EMBEDDING_MODEL=text-embedding-004

# Import RAG (Mongo collections document_formats + merchant_knowledge)
RAG_DOC_MATCH_THRESHOLD=0.62
RAG_MERCHANT_MATCH_THRESHOLD=0.48
IMPORT_CAT_CONFIDENCE_AUTO=0.72

# Finance news (monthly report context only — not an in-app feed)
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=

# Monthly report email (Resend free tier)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tally <onboarding@resend.dev>
